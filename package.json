{
  "name": "timedoor-tms-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Timedoor Academy teacher portal (TMS): lists, daily journal drafts, report lookups",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pdf-to-img": "^7.0.1",
    "playwright": "^1.49.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
