# Copy this file to .env and fill in your own values. Never commit .env.
TMS_USERNAME=
TMS_PASSWORD=

# Optional
# TMS_BASE_URL=https://cms.timedooracademy.com
# TMS_HEADLESS=true   (set to false to watch the browser while debugging)

# Optional, added Nov 2026
# TMS_PHOTO_DIR=/Users/you/Pictures/TMS Photos   (class photos folder; paths outside it are refused)
# TMS_TEACHER_ID=1001   (only if the server cannot work out which teacher is you)
# TMS_SESSION_FILE=~/.config/timedoor-tms-mcp/session.json   (where the saved login lives)
# TMS_ACTION_LOG=~/.config/timedoor-tms-mcp/actions.log      (one line per approval or send)

# Optional, lesson progress sync to Google Sheets (OFF by default; writes only when SYNC_ENABLED=true and dry_run=false)
# TMS_SHEET_ID=
# TMS_SHEET_GID=            (the number after gid= in your sheet tab link)
# TMS_SHEET_HIGHLIGHT_COLOR=  (your own colour for finished lessons, hex like #00ffff)
# TMS_SHEET_NAME_COLUMN=B
# TMS_SHEET_FIRST_ROW=
# TMS_SHEET_LESSON1_DATE_COLUMN=
# TMS_SHEET_CREDENTIALS=
# TMS_SHEET_SYNC_ENABLED=false
